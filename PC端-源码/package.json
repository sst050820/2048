{
  "name": "ninghe",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "productName": "凝合",
  "description": "凝合——果冻质感的软球合成游戏：发射软球、合成相同数字，别让球堆同时顶开两侧保险杠。",
  "config": {
    "forge": "forge.config.cjs"
  },
  "scripts": {
    "start": "electron .",
    "desktop:dev": "electron .",
    "desktop:package": "electron-forge package --platform=win32 --arch=x64",
    "desktop:make": "electron-forge make --platform=win32 --arch=x64",
    "desktop:dist": "electron-forge package --platform=win32 --arch=x64 && node tools/repack-zip.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "electron": "^44.9.0",
    "@electron/fuses": "2.1.3"
  }
}
